<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lizzie.Desktop.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <x:String x:Key="ApplicationName">LizzieYzy GL</x:String>
        <x:String x:Key="EmptyBoardName">Empty 19 by 19 Go board</x:String>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
